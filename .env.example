# Configure the intended database and matching Clerk keys; keep secrets out of Git.
# Current preview plan reuses development Clerk and the existing shared Neon DB.
# Scope preview keys separately: existing production uses a different Clerk instance.
# A separate preview URL does not isolate database changes.
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/overview
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding

# Browse-only by default. "demo" enables any signed-in account to book only
# the host below. Verify accutility778@gmail.com's Clerk user ID in the target
# Clerk instance; never use a visitor ID, email address or public handle here.
# Missing host ID or the retired "testers" mode leaves submissions blocked.
# Google OAuth testers are a separate list in Google Cloud.
KALENDER_BOOKING_MODE=disabled
KALENDER_DEMO_HOST_CLERK_USER_ID=
# Landing-page demo link. Use a separate profile for each Clerk host/instance.
KALENDER_DEMO_PROFILE_HANDLE=demo-strategy-studio
# Optional one-click shared demo access. Exactly three provisioned visitor IDs
# in this Clerk instance, never the host. These are sign-in targets, not a
# booking allowlist. Each must carry the verified private demo marker.
# KALENDER_DEMO_VISITOR_USER_IDS=

# Seed-only variables; do not configure confirmation in the hosting runtime.
# KALENDER_DEMO_CLERK_USER_ID=
# KALENDER_DEMO_SEED_CONFIRM=replace-demo-owner
# KALENDER_DEMO_HANDLE=demo-strategy-studio

# One-off script only (scripts/create-demo-testers.mjs, "npm run
# demo:create-testers"). Creates shared visitor logins, not the Calendar host.
# No visitor allowlist is needed. The deployed app never reads these variables.
# Development Clerk only: +clerk_test addresses use verification code 424242.
# KALENDER_DEMO_TESTER_PASSWORD=
# KALENDER_DEMO_TESTER_CONFIRM=create-demo-testers
# KALENDER_DEMO_TESTER_COUNT=3
# KALENDER_DEMO_TESTER_EMAIL_DOMAIN=example.com
